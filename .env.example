# Copy to ~/.config/whisper/.env to enable cleanup mode (Cmd+Opt+Shift+Space).
# With no .env, cleanup mode just pastes the raw transcript.
#
# Preferred: a local model via Ollama — nothing ever leaves your Mac.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
#
# Or xAI Grok, the only cloud provider Whisper will talk to
# (never OpenAI, Google, or Anthropic):
# XAI_API_KEY=
# LLM_MODEL=grok-4-fast-non-reasoning
